# ─── Core ───
NODE_ENV=development
PORT=3000

# Telegram bot token (BotFather). Required in production for initData auth + Stars.
BOT_TOKEN=

# Public URL of the mini app (used by bot buttons)
MINI_APP_URL=https://example.com/deadwill

# ─── Database ───
# Leave DATABASE_URL empty to use a local SQLite file (zero-config dev).
# Set it to a postgres:// URL for production (then `npm i pg` in the api workspace).
DATABASE_URL=
# SQLITE_PATH=./src/api/data/deadwill.sqlite

# initData freshness window in seconds
INITDATA_TTL=3600

# ─── TON deposits (on-chain verification) ───
# Our receiving wallet. Users send the pack amount with the deposit id as comment.
PROJECT_TON_WALLET=
TONCENTER_BASE=https://toncenter.com/api/v2
TON_API_KEY=
TON_POLL_MS=20000

# ─── Local dev only ───
# When there is no BOT_TOKEN, allow identifying the user via the X-Dev-User header.
# NEVER enable on a server that has a real BOT_TOKEN / real users.
ALLOW_DEV_AUTH=0
